<aside :class="showMobileServices ? 'translate-x-0' : 'translate-x-full md:translate-x-0'"
       class="fixed md:relative inset-y-0 right-0 w-72 lg:w-80 max-w-[85vw] border-l border-slate-200 dark:border-white/5 bg-sidebar flex flex-col z-[100] md:z-10 shadow-[-10px_0_30px_rgba(0,0,0,0.05)] dark:shadow-[-10px_0_30px_rgba(0,0,0,0.5)] transition-all duration-500 ease-in-out theme-transition">
    
    <!-- Mobile Header -->
    <div class="md:hidden flex items-center justify-between px-8 py-5 border-b border-subtle bg-card backdrop-blur-md">
        <div class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.5)]"></span>
            <h3 class="text-[11px] mono text-slate-900 dark:text-white uppercase tracking-[0.4em] font-black italic">Directory</h3>
        </div>
        <button @click="showMobileServices = false" aria-label="Close services sidebar" class="p-2 bg-slate-100 dark:bg-white/5 rounded-xl text-slate-400 hover:text-orange-500 transition-all active:scale-90">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Desktop Header -->
    <div class="p-5 border-b border-slate-200 dark:border-white/5 bg-sidebar hidden md:block theme-transition"
         @keydown.window.prevent.slash="$refs.serviceSearch.focus()">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-[10px] mono text-slate-500 dark:text-slate-400 uppercase tracking-[0.4em] font-black">Directory</h3>
            <div class="flex gap-1.5">
                <div class="w-1 h-1 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.5)]"></div>
            </div>
        </div>
        
        <div class="relative group/search">
            <input type="text" id="serviceSearch" name="serviceSearch" aria-label="Search services" x-model.debounce.200ms="serviceSearch" 
                   x-ref="serviceSearch"
                   placeholder="Filter services..." 
                   class="w-full bg-slate-100 dark:bg-white/[0.03] border border-transparent dark:border-white/10 rounded-2xl py-2.5 pl-10 pr-10 text-[11px] focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500/30 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-600 shadow-inner font-medium">
            <svg class="absolute left-3.5 top-[11px] w-3.5 h-3.5 text-slate-400 dark:text-slate-600 group-focus-within/search:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <div class="absolute right-3.5 top-[11px] hidden lg:flex items-center opacity-20 group-focus-within/search:opacity-0 transition-opacity pointer-events-none">
                <span class="text-[10px] mono border border-slate-400 rounded px-1.5">/</span>
            </div>
        </div>
    </div>
    
    <!-- Unified Search for Mobile (Visible top) -->
    <div class="md:hidden p-6 border-b border-subtle bg-sidebar">
        <div class="relative group/search">
            <input type="text" id="serviceSearchMobile" name="serviceSearchMobile" aria-label="Search services on mobile" x-model.debounce.200ms="serviceSearch" placeholder="Filter services..." 
                   class="w-full bg-slate-100 dark:bg-white/[0.03] border border-transparent dark:border-white/10 rounded-2xl py-3.5 pl-11 pr-4 text-sm focus:outline-none transition-all text-slate-900 dark:text-white shadow-inner">
            <svg class="absolute left-4 top-3.5 w-4 h-4 text-slate-400 dark:text-slate-600 group-focus-within/search:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto p-6 space-y-2 custom-scroll bg-sidebar">
        <template x-for="service in filteredServices" :key="service">
            <button @click="openService(service); if(isMobile(768)) showMobileServices = false;" 
                    class="w-full text-left px-4 py-3 rounded-xl hover:bg-white dark:hover:bg-white/10 group transition-all flex items-center justify-between border border-transparent hover:border-slate-200 dark:hover:border-white/20 relative overflow-hidden shadow-sm hover:shadow-md active:scale-95">
                
                <div class="absolute inset-0 bg-gradient-to-r from-orange-500/0 via-orange-500/[0.05] to-orange-500/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                
                <div class="flex items-center gap-4 relative z-10">
                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-white/10 flex items-center justify-center mono text-[10px] text-slate-500 dark:text-slate-300 group-hover:text-orange-500 group-hover:bg-orange-500/10 transition-all border border-transparent dark:border-white/10 group-hover:border-orange-500/20" x-text="service.substring(0,1).toUpperCase()"></div>
                    <div class="flex flex-col">
                        <span class="mono text-[11px] text-slate-600 dark:text-slate-200 group-hover:text-slate-900 dark:group-hover:text-white font-black tracking-tight transition-colors uppercase" x-text="service"></span>
                        <template x-if="['s3', 'ec2', 'iam', 'lambda', 'dynamodb', 'sqs', 'sns', 'sts', 'cloudwatch', 'rds'].includes(service.toLowerCase())">
                            <span class="text-[7px] mono font-bold text-orange-500 uppercase tracking-widest mt-0.5 opacity-80 group-hover:opacity-100 transition-opacity">Core Intel</span>
                        </template>
                    </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-orange-500 transition-all -translate-x-1 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </template>
    </div>

    <div class="p-3 border-t border-slate-200 dark:border-white/5 bg-card hidden md:block theme-transition relative overflow-hidden group/status">
        <div class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-xl p-3 shadow-sm hover:border-emerald-500/20 transition-all group">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-1.5">
                    <span class="w-1 h-1 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[8px] mono text-slate-400 dark:text-slate-600 uppercase tracking-widest font-black">Active Node</span>
                </div>
                <svg class="w-3 h-3 text-slate-300 dark:text-slate-700 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <div class="flex flex-col">
                <span class="text-xl font-black text-slate-900 dark:text-white italic tracking-tighter leading-none" x-text="allServices.length"></span>
                <span class="text-[7px] mono text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-1.5">Indexed Services</span>
            </div>
        </div>
    </div>
</aside>