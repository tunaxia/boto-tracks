<aside :class="showMobileVersions ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
       class="fixed lg:relative inset-y-0 left-0 w-32 md:w-40 flex-shrink-0 border-r border-subtle flex flex-col bg-sidebar z-[100] lg:z-20 transition-all duration-500 ease-in-out theme-transition">
    
    <!-- Mobile Header -->
    <div class="lg:hidden flex items-center justify-between p-6 border-b border-subtle bg-card">
        <span class="text-orange-500 font-black italic tracking-tighter uppercase text-[10px]">Releases</span>
        <button @click="showMobileVersions = false" aria-label="Close versions sidebar" class="p-2 text-slate-400 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Brand Area -->
    <div class="h-44 flex flex-col items-center justify-center flex-shrink-0 relative z-30 bg-sidebar theme-transition border-b border-subtle">
        <button @click="location.reload()" 
                aria-label="Reload page"
                class="w-12 h-12 bg-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-orange-500/20 cursor-pointer hover:rotate-12 hover:scale-110 transition-all duration-300 active:scale-95 group relative mb-4">
            <img src="/favicon.png" width="32" height="32" alt="Boto Tracks by Tunaxia" class="w-8 h-8 pointer-events-none" />
        </button>
        <div class="hidden lg:flex flex-col items-center text-center px-4">
            <h1 class="text-[10px] font-black italic uppercase tracking-tighter text-main leading-none">Boto Tracks</h1>
            <p class="text-[7px] mono text-slate-500 uppercase tracking-widest mt-1.5 leading-tight opacity-70">AWS Botocore & Boto3 Changelog Intelligence</p>
        </div>
    </div>

    <div class="px-4 pb-4 border-b border-subtle bg-sidebar theme-transition">
        <div class="relative group">
            <input type="text" id="versionRailSearch" name="versionRailSearch" x-model="versionRailSearch" placeholder="Jump to..." 
                   class="w-full bg-slate-100 dark:bg-white/[0.03] border border-transparent dark:border-white/10 rounded-xl py-2 pl-8 pr-3 text-[10px] focus:outline-none focus:ring-2 focus:ring-orange-500/20 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-600 shadow-inner">
            <svg class="absolute left-2.5 top-2.5 w-3 h-3 text-slate-400 dark:text-slate-600 group-focus-within:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
    </div>
    
    <!-- Version Rail -->
    <div class="flex-1 w-full relative group/rail overflow-hidden flex flex-col">
        <div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[1px] bg-black/10 dark:bg-white/10 z-0"></div>
        <div class="absolute left-1/2 -translate-x-1/2 w-[2px] bg-orange-500 shadow-[0_0_15px_rgba(249,115,22,0.6)] z-10 transition-all duration-500"
             style="height: 40px; top: var(--glow-top, 0px);"
             x-show="selectedVersion && !versionRailSearch"></div>

        <div class="flex-1 overflow-y-auto hide-scrollbar relative z-20 px-4">
            <div class="flex flex-col items-center gap-4 py-6 pb-20 relative">
                <template x-for="v in filteredRailVersions" :key="v.id">
                    <button @click="selectVersion(v.id); if(window.innerWidth < 1024) showMobileVersions = false;" 
                            :data-version="v.id"
                            :class="selectedVersion === v.id ? 'border-orange-500 bg-white dark:bg-[#0a0a0a] scale-105 shadow-xl opacity-100' : 'border-transparent bg-sidebar dark:bg-[#0a0a0a] opacity-70 hover:opacity-100 hover:scale-105'"
                            class="relative w-full max-w-[110px] h-10 border-2 rounded-xl flex items-center justify-center transition-all duration-500 group flex-shrink-0 z-30 shadow-sm overflow-hidden">
                        <div class="absolute inset-0 bg-inherit z-0"></div>
                        <span class="text-[10px] mono font-black tracking-tight relative z-10" 
                              :class="selectedVersion === v.id ? 'text-orange-500' : 'text-slate-800 dark:text-slate-200 group-hover:text-slate-900 dark:group-hover:text-white'" 
                              x-text="v.id"></span>
                    </button>
                </template>
            </div>
        </div>
        <div class="absolute top-0 left-0 right-0 h-8 bg-gradient-to-b from-sidebar to-transparent z-40 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-sidebar to-transparent z-40 pointer-events-none"></div>
    </div>

    <!-- Sidebar Footer Actions -->
    <div class="p-4 border-t border-subtle bg-sidebar theme-transition flex flex-col gap-2">
        <a href="https://github.com/tunaxia/boto-tracks" target="_blank" 
           aria-label="GitHub Repository"
           class="flex items-center justify-center w-full py-2 px-3 rounded-lg bg-slate-100 dark:bg-white/5 text-slate-500 hover:text-orange-500 transition-all border border-transparent dark:border-white/5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.082.824-.26.824-.578 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            <span class="text-[9px] mono font-bold ml-2 uppercase tracking-widest hidden md:inline">Repo</span>
        </a>
    </div>
</aside>