<main class="flex-1 flex flex-col min-w-0 bg-inherit relative theme-transition">
    
    <header class="h-16 border-b border-subtle flex items-center justify-between px-4 md:px-12 bg-white/80 dark:bg-[#050505]/80 backdrop-blur-md sticky top-0 z-50">
        <div class="flex items-center gap-6">
            <!-- Mobile Versions Toggle -->
            <button @click="showMobileVersions = true" aria-label="Open versions sidebar" class="lg:hidden p-2 text-slate-400 hover:text-orange-500 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
            </button>

            <!-- Mobile Brand Title -->
            <button @click="location.reload()" 
                    aria-label="Refresh page"
                    class="md:hidden flex items-center mr-2 active:scale-95 transition-transform cursor-pointer group/mobile-brand">
                <span class="text-[11px] font-black italic uppercase tracking-tighter text-orange-500">Boto Tracks</span>
            </button>

            <div class="flex items-center gap-4">
                <span class="hidden sm:inline text-[10px] mono text-slate-400 uppercase tracking-widest font-bold">Release</span>
                <div class="px-3 py-1 bg-orange-500/5 border border-orange-500/20 rounded-lg">
                    <span class="text-xs md:text-sm mono font-black text-orange-600 dark:text-orange-400" x-text="selectedVersion || '...'"></span>
                </div>
            </div>
            
            <!-- Local Search -->
            <div class="hidden md:block relative w-48 lg:w-64 group">
                <input type="text" id="versionSearch" name="versionSearch" aria-label="Search logs" x-model.debounce.200ms="versionSearch" placeholder="Search logs..." 
                       class="w-full bg-slate-100 dark:bg-white/5 border border-transparent focus:border-orange-500/20 rounded-full py-1.5 pl-9 pr-4 text-[11px] focus:outline-none transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-600">
                <svg class="absolute left-3 top-2 w-3.5 h-3.5 text-slate-400 group-focus-within:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <!-- Filter Pills (Unified with state) -->
            <div class="hidden lg:flex items-center gap-1 p-1 bg-slate-100 dark:bg-white/5 rounded-full border border-subtle">
                <button @click="activeFilter = 'all'" :class="activeFilter === 'all' ? 'bg-white dark:bg-white/10 text-orange-500 shadow-sm' : 'text-slate-500'" class="px-3 py-1 rounded-full text-[9px] mono font-bold uppercase transition-all">All</button>
                <button @click="activeFilter = 'feature'" :class="activeFilter === 'feature' ? 'bg-white dark:bg-white/10 text-emerald-500 shadow-sm' : 'text-slate-500'" class="px-3 py-1 rounded-full text-[9px] mono font-bold uppercase transition-all">Features</button>
                <button @click="activeFilter = 'fix'" :class="activeFilter === 'fix' ? 'bg-white dark:bg-white/10 text-amber-500 shadow-sm' : 'text-slate-500'" class="px-3 py-1 rounded-full text-[9px] mono font-bold uppercase transition-all">Fixes</button>
            </div>

            <!-- Mobile Services Toggle -->
            <button @click="showMobileServices = true" aria-label="Open services sidebar" class="md:hidden p-2 text-slate-400 hover:text-orange-500 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
            </button>
        </div>
    </header>

    <div class="flex-1 overflow-y-auto p-6 md:p-12 custom-scroll">
        <div class="max-w-4xl mx-auto min-h-[calc(100vh-140px)] flex flex-col">
            <div class="flex-1">
                <!-- Mobile Search -->
                <div class="sm:hidden mb-8">
                    <input type="text" id="versionSearchMobile" name="versionSearchMobile" aria-label="Search version logs on mobile" x-model.debounce.200ms="versionSearch" placeholder="Search version logs..." 
                           class="w-full bg-slate-100 dark:bg-white/5 border border-subtle rounded-xl py-3 px-5 text-sm focus:outline-none transition-all text-slate-900 dark:text-white shadow-inner">
                </div>

                <div class="divide-y divide-slate-200/50 dark:divide-white/5">
                    <!-- Skeleton Loader -->
                    <template x-if="loading || currentVersionData.length === 0">
                        <div class="space-y-8 animate-pulse pt-4">
                            <template x-for="i in 5">
                                <div class="flex items-start gap-6 py-6">
                                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-white/5"></div>
                                    <div class="flex-1 space-y-3">
                                        <div class="h-4 w-1/4 bg-slate-200 dark:bg-white/5 rounded"></div>
                                        <div class="h-4 w-full bg-slate-100 dark:bg-white/5 rounded"></div>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </template>

                    <template x-for="(change, index) in filteredVersionData" :key="index">
                        <div class="group flex items-start gap-4 md:gap-6 py-8 hover:bg-slate-50/50 dark:hover:bg-white/[0.01] transition-colors -mx-4 px-4 rounded-xl">
                            <!-- Service Icon (Simple) -->
                            <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-white/5 border border-subtle flex items-center justify-center flex-shrink-0 group-hover:border-orange-500/20 transition-all shadow-sm">
                                <span class="text-orange-500 font-bold mono text-[9px]" x-text="change.category.substring(0,2).toUpperCase()"></span>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2.5 mb-2.5">
                                    <button @click="openService(change.category)" 
                                            class="px-2 py-0.5 bg-orange-500/5 dark:bg-white/5 border border-orange-500/10 dark:border-white/5 rounded-md text-[10px] mono font-black text-orange-600 dark:text-orange-400 hover:text-white hover:bg-orange-500 transition-all uppercase tracking-widest" 
                                            x-text="change.category"></button>
                                    
                                    <span :class="{
                                        'text-emerald-700 dark:text-emerald-400 border-emerald-500/20 bg-emerald-500/10': change.type.includes('change') || change.type.includes('api'),
                                        'text-amber-700 dark:text-amber-400 border-amber-500/20 bg-amber-500/10': change.type.includes('fix'),
                                        'text-blue-700 dark:text-blue-400 border-blue-500/20 bg-blue-500/10': !change.type.includes('change') && !change.type.includes('fix') && !change.type.includes('api')
                                    }" class="text-[8px] font-bold border px-2 py-0.5 rounded-md uppercase tracking-wider" x-text="change.type.includes('api') ? 'api change' : change.type"></span>
                                </div>
                                <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-[14px] md:text-[15px] font-medium tracking-tight group-hover:text-slate-900 dark:group-hover:text-white transition-colors break-words" x-text="change.description"></p>
                            </div>
                        </div>
                    </template>
                </div>
                
                <!-- Empty State -->
                <template x-if="filteredVersionData.length === 0">
                    <div class="flex flex-col items-center justify-center py-24 text-center">
                        <h3 class="text-slate-900 dark:text-white text-lg font-bold mb-2 uppercase italic tracking-tighter">No logs found</h3>
                        <p class="text-slate-500 mono text-[9px] uppercase tracking-widest">Adjust filters for release <span x-text="selectedVersion"></span></p>
                        <button @click="versionSearch = ''; activeFilter = 'all'" class="mt-8 px-6 py-2 border border-orange-500/30 text-orange-500 text-[10px] font-black rounded-full hover:bg-orange-500 hover:text-white transition-all uppercase tracking-widest">Clear Search</button>
                    </div>
                </template>
            </div>

            <!-- Footer -->
            <footer x-cloak class="mt-32 pt-16 pb-24 border-t border-subtle relative opacity-90 hover:opacity-100 transition-opacity duration-700">
                <!-- Subtle Top Glow -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-[1px] bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>
                
                <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-12 text-center md:text-left">
                    <!-- Brand Section -->
                    <div class="flex flex-col items-center md:items-start gap-5">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6 h-6 bg-orange-500/10 border border-orange-500/20 rounded-lg flex items-center justify-center shadow-sm">
                                <img src="/favicon.png" width="14" height="14" alt="Boto Tracks" class="w-[14px] h-[14px] aspect-square opacity-90" />
                            </div>
                            <span class="text-[11px] mono font-black uppercase tracking-[0.4em] text-slate-800 dark:text-white">Boto Tracks</span>
                        </div>
                        <p class="text-[10px] leading-relaxed text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold max-w-[240px]">
                            Modern intelligence for the AWS SDK ecosystem. Tracking every pulse of Botocore.
                        </p>
                        
                        <!-- System Status -->
                        <div class="flex items-center gap-2 px-3 py-1 bg-emerald-500/5 border border-emerald-500/10 rounded-full">
                            <span class="w-1 h-1 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-[8px] mono font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">System Nominal</span>
                        </div>
                    </div>

                    <!-- Action Section -->
                    <div class="flex flex-col items-center md:items-end gap-8">
                        <div class="flex flex-col items-center md:items-end gap-3">
                            <span class="text-[9px] mono font-bold text-slate-400 dark:text-slate-600 uppercase tracking-[0.2em]">Support the project</span>
                            <a href="https://github.com/tunaxia/boto-tracks" target="_blank" 
                               class="inline-flex items-center gap-3 px-6 py-3 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-2xl hover:border-orange-500/40 hover:bg-orange-500/5 transition-all group shadow-sm active:scale-95">
                                <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 .587l3.668 7.431 8.332 1.21-6.001 5.85 1.416 8.297-7.415-3.897-7.415 3.897 1.416-8.297-6.001-5.85 8.332-1.21z"/>
                                </svg>
                                <span class="text-[10px] mono font-black uppercase tracking-widest text-slate-700 dark:text-slate-200 group-hover:text-orange-500 transition-colors">Star on GitHub</span>
                            </a>
                        </div>
                        
                        <div class="flex flex-col items-center md:items-end gap-1.5">
                            <p class="text-[10px] mono font-black uppercase tracking-widest text-slate-500 dark:text-slate-300">
                                &copy; {new Date().getFullYear()} Boto Tracks
                            </p>
                            <p class="text-[9px] mono uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                                Crafted by <a href="https://tunaxia.com" target="_blank" class="text-orange-500 hover:text-orange-400 transition-colors font-black">Tunaxia</a>
                            </p>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
</main>