---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<link rel="preload" href="/data/track.json" as="fetch" crossorigin="anonymous" />
		
		<!-- Google tag (gtag.js) -->
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-L9MXJPQ4BW"></script>
		<script type="text/partytown">
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-L9MXJPQ4BW');
		</script>
		<meta name="msvalidate.01" content="4950DCD271185D133A4FA2B7A215D7D5" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content="Boto Tracks: The definitive AWS Boto3 and Botocore changelog tracker. Search, filter, and track every AWS SDK update, fix, and feature in real-time. Learn how to track boto changes efficiently." />
		<meta name="keywords" content="boto tracks, boto-tracks, aws boto tracks, aws sdk python, botocore changelog, boto3 updates, aws sdk tracker, python aws development, botocore intelligence, boto3 release notes, aws changelog, how to track boto changes" />
		<meta name="author" content="Tunaxia" />
		
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Boto Tracks | AWS Boto3 & Botocore Intelligence Tracker" />
		<meta property="og:description" content="The ultimate platform for AWS Boto3 and Botocore updates. Search and track every AWS SDK for Python change in real-time." />
		<meta property="og:url" content="https://boto-tracks.tunaxia.com/" />
		<meta property="og:image" content="https://boto-tracks.tunaxia.com/favicon.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content="Boto Tracks | AWS Boto3 & Botocore Intelligence Tracker" />
		<meta property="twitter:description" content="Search and filter every update in the Boto ecosystem. Track AWS SDK changes with ease." />
		<meta property="twitter:image" content="https://boto-tracks.tunaxia.com/favicon.png" />

		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<script is:inline>
			(function() {
				const setTheme = () => {
					const darkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', darkMode);
				};
				setTheme();
				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', setTheme);
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap">
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
		
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@graph": [
			{
			  "@type": "WebSite",
			  "@id": "https://boto-tracks.tunaxia.com/#website",
			  "url": "https://boto-tracks.tunaxia.com/",
			  "name": "Boto Tracks",
			  "publisher": { "@id": "https://tunaxia.com/#organization" },
			  "description": "Modern AWS Boto3 & Botocore changelog tracker and intelligence platform."
			},
			{
			  "@type": "Organization",
			  "@id": "https://tunaxia.com/#organization",
			  "name": "Tunaxia",
			  "url": "https://tunaxia.com/",
			  "logo": "https://boto-tracks.tunaxia.com/favicon.png",
			  "sameAs": [
				"https://github.com/tunaxia"
			  ]
			},
			{
			  "@type": "SoftwareApplication",
			  "@id": "https://boto-tracks.tunaxia.com/#software",
			  "name": "Boto Tracks",
			  "applicationCategory": "DeveloperApplication",
			  "operatingSystem": "Web",
			  "author": { "@id": "https://tunaxia.com/#organization" },
			  "description": "A high-performance interface for tracking AWS Boto3 and Botocore changelogs, developed by Tunaxia."
			},
			{
			  "@type": "FAQPage",
			  "mainEntity": [
				{
				  "@type": "Question",
				  "name": "What is Boto Tracks?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "Boto Tracks is the definitive intelligence platform for tracking and searching changes in the AWS SDK for Python (Boto3 and Botocore). It provides a real-time searchable timeline of all AWS updates."
				  }
				},
				{
				  "@type": "Question",
				  "name": "How to track boto changes?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "You can track Boto changes using Boto Tracks. It provides a comprehensive dashboard to filter updates by AWS service (like S3, EC2, Lambda) and release version, making it easy to see exactly what changed in the AWS SDK for Python."
				  }
				},
				{
				  "@type": "Question",
				  "name": "What are AWS Boto Tracks?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "AWS Boto Tracks refers to the historical tracking of releases and updates for the AWS SDK for Python (Boto3 and Botocore). This includes tracking new features, API changes, and bug fixes across all AWS services."
				  }
				}
			  ]
			}
		  ]
		}
		</script>
	</head>
	<body class="h-screen w-full overflow-hidden bg-main transition-colors duration-500">
		<noscript>
			<div style="padding: 2rem; background: #fff; color: #000; font-family: sans-serif;">
				<h1>Boto Tracks | AWS Boto3 & Botocore Changelog Tracker</h1>
				<p>
					<strong>Boto Tracks</strong> is a dedicated tool for tracking the <strong>botocore</strong> and <strong>boto3</strong> changes. 
					Monitor updates, bug fixes, and new feature releases across the entire AWS SDK ecosystem efficiently.
				</p>
			</div>
		</noscript>
		<slot />
	</body>
</html>