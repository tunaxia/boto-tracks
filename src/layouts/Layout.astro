---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Boto Tracker | AWS SDK for Python (Botocore) Changelog</title>
		<meta name="description" content="A modern, fast, and searchable interface for tracking changes, fixes, and features in the AWS SDK for Python (Botocore). Stay updated with every Boto3/Botocore release." />
		<meta name="keywords" content="boto3, botocore, aws, python, sdk, tracker, changelog, cloud, amazon web services, updates, release notes" />
		<meta name="author" content="Boto Tracker" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Boto Tracker | AWS SDK for Python (Botocore) Changelog" />
		<meta property="og:description" content="Track every change, fix, and feature in the AWS SDK for Python (Botocore) with a modern searchable interface." />
		<meta property="og:image" content="/favicon.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content="Boto Tracker | AWS SDK for Python (Botocore) Changelog" />
		<meta property="twitter:description" content="Track every change, fix, and feature in the AWS SDK for Python (Botocore) with a modern searchable interface." />
		<meta property="twitter:image" content="/favicon.png" />

		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<script is:inline>
			// Immediate theme initialization
			(function() {
				const savedTheme = localStorage.getItem('boto-theme');
				const darkMode = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (darkMode) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
		<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body class="h-screen overflow-hidden text-slate-400">
		<slot />
	</body>
</html>