---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-L9MXJPQ4BW"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-L9MXJPQ4BW');
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | AWS Boto Tracks by Tunaxia</title>
		<meta name="description" content="Boto Tracks: The definitive AWS SDK for Python (Botocore) changelog intelligence platform. Search and filter every update, fix, and feature in the Boto ecosystem." />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Boto Tracks | AWS Botocore Intelligence" />
		<meta property="og:description" content="Modern, high-performance AWS Botocore & Boto3 changelog tracker. Built for developers by Tunaxia." />
		<meta property="og:url" content="https://boto-tracks.tunaxia.com/" />
		<meta property="og:image" content="https://boto-tracks.tunaxia.com/favicon.png" />

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="preload" href="/data/track.json" as="fetch" crossorigin="anonymous">

		<script is:inline>
			(function() {
				const setTheme = () => {
					const darkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', darkMode);
				};
				setTheme();
				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', setTheme);
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
	</head>
	<body class="h-screen w-full overflow-hidden bg-main transition-colors duration-500">
		<slot />
	</body>
</html>