---
import Layout from '../layouts/Layout.astro';
import LeftRail from '../components/LeftRail.astro';
import MainView from '../components/MainView.astro';
import ServiceNav from '../components/ServiceNav.astro';
---

<Layout title="Boto Tracker">
    <div class="flex h-screen w-full overflow-hidden bg-main text-[var(--text-secondary)] theme-transition" 
         x-data="botoCore" 
         x-cloak
         @keydown.window.escape="showMobileServices = false; showMobileVersions = false; activeService = null">
        
        <!-- Backdrops for Mobile -->
        <div x-show="showMobileVersions" 
             x-transition:enter="transition-opacity ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[90] lg:hidden" 
             @click="showMobileVersions = false"></div>

        <div x-show="showMobileServices" 
             x-transition:enter="transition-opacity ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[90] md:hidden" 
             @click="showMobileServices = false"></div>

        <div x-show="error" x-transition.opacity class="fixed inset-0 z-[60] flex items-center justify-center p-6 bg-black/90 backdrop-blur-md">
            <div class="bg-red-950/40 border border-red-500/30 text-red-200 p-8 rounded-3xl max-w-lg w-full text-center shadow-[0_0_50px_rgba(239,68,68,0.15)]">
                <div class="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h2 class="text-3xl font-bold text-white mb-2 uppercase tracking-tighter italic">Critical Error</h2>
                <p class="text-slate-400 mb-8 leading-relaxed" x-text="error"></p>
                <button @click="location.reload()" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-8 rounded-full transition-all active:scale-95">Retry Session</button>
            </div>
        </div>

        <div x-show="loading" x-transition.opacity class="flex-1 flex flex-col items-center justify-center bg-main theme-transition">
            <div class="w-12 h-12 border-4 border-orange-500/20 border-t-orange-500 rounded-full animate-spin mb-4"></div>
            <p class="mono text-slate-500 text-sm animate-pulse uppercase tracking-widest">Initialising Core...</p>
        </div>

        <template x-if="!error && !loading">
            <div class="flex h-full w-full" x-transition.opacity.duration.500ms>
                <LeftRail />
                <MainView />
                <ServiceNav />
            </div>
        </template>

        <!-- Service History Drawer -->
        <div x-show="activeService" class="fixed inset-0 z-50 flex justify-end overflow-hidden" x-cloak>
            <!-- Overlay -->
            <div x-show="activeService" 
                 x-transition:enter="ease-in-out duration-500" 
                 x-transition:enter-start="opacity-0" 
                 x-transition:enter-end="opacity-100" 
                 x-transition:leave="ease-in-out duration-500" 
                 x-transition:leave-start="opacity-100" 
                 x-transition:leave-end="opacity-0" 
                 class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" 
                 @click="activeService = null"></div>

            <!-- Drawer Panel -->
            <div x-show="activeService" 
                 x-transition:enter="transform transition ease-in-out duration-500 sm:duration-700" 
                 x-transition:enter-start="translate-x-full" 
                 x-transition:enter-end="translate-x-0" 
                 x-transition:leave="transform transition ease-in-out duration-500 sm:duration-700" 
                 x-transition:leave-start="translate-x-0" 
                 x-transition:leave-end="translate-x-full" 
                 class="relative w-screen max-w-2xl bg-sidebar border-l border-subtle shadow-2xl flex flex-col h-full theme-transition">
                
                <div class="px-8 py-10 border-b border-subtle bg-card theme-transition">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] mono text-orange-500 font-black uppercase tracking-[0.3em]">Service</span>
                        <button @click="activeService = null" class="text-slate-400 dark:text-slate-500 hover:text-orange-500 transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <h2 class="text-3xl font-black text-main italic uppercase tracking-tighter leading-none mb-8" x-text="activeService"></h2>
                    
                    <!-- Dossier Search -->
                    <div class="relative group">
                        <input type="text" id="serviceHistorySearch" name="serviceHistorySearch" x-model="serviceHistorySearch" placeholder="Filter history..." 
                               class="w-full bg-slate-100 dark:bg-white/[0.03] border border-transparent dark:border-white/10 rounded-xl py-3 pl-11 pr-4 text-xs focus:outline-none focus:ring-2 focus:ring-orange-500/20 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-600 shadow-inner">
                        <svg class="absolute left-4 top-3.5 w-4 h-4 text-slate-400 dark:text-slate-600 group-focus-within:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto p-12 custom-scroll space-y-12 bg-inherit">
                    <div class="relative">
                        <div class="absolute left-0 top-0 bottom-0 w-[1px] bg-gradient-to-b from-orange-500/50 via-slate-200 dark:via-white/5 to-transparent"></div>
                        
                        <div class="space-y-16">
                            <template x-for="log in filteredServiceHistory" :key="log.v + log.t">
                                <div class="relative pl-12 group">
                                    <div class="absolute -left-[4.5px] top-1.5 w-2.5 h-2.5 rounded-full bg-white dark:bg-black border-2 border-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.5)] group-hover:scale-150 transition-transform"></div>
                                    
                                    <div class="flex items-center gap-3 mb-3">
                                        <button @click="selectVersion(log.v); activeService = null" 
                                                title="Jump to this version"
                                                class="px-3 py-1 bg-slate-100 dark:bg-white/5 border border-subtle rounded-full mono text-[10px] font-bold text-slate-500 dark:text-slate-400 hover:text-orange-500 hover:border-orange-500/30 hover:bg-orange-500/5 transition-all active:scale-95" 
                                                x-text="log.v"></button>
                                        <div class="h-[1px] flex-1 bg-black/5 dark:bg-white/5"></div>
                                    </div>
                                    
                                    <p class="text-slate-700 dark:text-slate-300 text-sm font-medium leading-relaxed tracking-tight group-hover:text-slate-900 dark:group-hover:text-white transition-colors" x-text="log.t"></p>
                                </div>
                            </template>

                            <!-- Empty History Search -->
                            <template x-if="filteredServiceHistory.length === 0">
                                <div class="py-20 text-center opacity-40">
                                    <p class="text-xs mono uppercase tracking-widest">No logs match your filter</p>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <div class="p-8 border-t border-subtle bg-card text-center theme-transition">
                    <p class="text-[10px] mono text-slate-400 dark:text-slate-600 uppercase tracking-widest">End of History Record</p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline>
    document.addEventListener('alpine:init', () => {
        Alpine.data('botoCore', () => ({
            selectedVersion: '',
            versions: [],
            allServices: [],
            currentVersionData: [],
            serviceSearch: '',
            versionSearch: '',
            versionRailSearch: '',
            activeService: null,
            serviceHistory: [],
            serviceHistorySearch: '',
            showMobileServices: false,
            showMobileVersions: false,
            error: null,
            loading: true,

            async init() {
                try {
                    const res = await fetch('/data/track.json');
                    if (!res.ok) throw new Error('Failed to load track data');
                    const data = await res.json();
                    this.versions = data.versions;
                    this.allServices = data.allServices;

                    if (this.versions.length > 0) {
                        await this.selectVersion(this.versions[0].id);
                    }
                } catch (e) {
                    console.error("Init failed:", e);
                    this.error = e.message;
                } finally {
                    this.loading = false;
                }
            },

            async selectVersion(id) {
                this.selectedVersion = id;
                this.versionSearch = '';
                try {
                    const res = await fetch(`/data/versions/${id}.json`);
                    if (!res.ok) throw new Error(`Version ${id} not found`);
                    this.currentVersionData = await res.json();
                    
                    // Update Glow Position
                    setTimeout(() => {
                        const rail = document.querySelector('.group\\/rail');
                        const activeBtn = rail?.querySelector(`button[data-version="${id}"]`);
                        if (rail && activeBtn) {
                            rail.style.setProperty('--glow-top', activeBtn.offsetTop + 'px');
                        }
                    }, 50);
                } catch (e) { 
                    console.error(e);
                    this.error = `Could not load version ${id}.`;
                }
            },

            async openService(svc) {
                const serviceId = this.slugify(svc);
                this.activeService = svc;
                this.serviceHistory = [];
                this.serviceHistorySearch = '';
                try {
                    const res = await fetch(`/data/services/${serviceId}.json`);
                    if (!res.ok) throw new Error(`Service file for ${serviceId} not found`);
                    this.serviceHistory = await res.json();
                } catch (e) { 
                    console.error(e);
                    this.serviceHistory = []; 
                }
            },

            slugify(text) {
                if (!text) return 'unknown';
                return text.toString().toLowerCase().trim()
                    .replace(/[`]/g, '')
                    .replace(/[\._\s]+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-+|-+$/g, '');
            },

            get filteredServices() {
                if (!this.serviceSearch) return this.allServices;
                const s = this.serviceSearch.toLowerCase();
                return this.allServices.filter(svc => svc.toLowerCase().includes(s));
            },

            get filteredRailVersions() {
                if (!this.versionRailSearch) return this.versions;
                return this.versions.filter(v => v.id.includes(this.versionRailSearch));
            },

            get filteredServiceHistory() {
                if (!this.serviceHistorySearch) return this.serviceHistory;
                const s = this.serviceHistorySearch.toLowerCase();
                return this.serviceHistory.filter(log => 
                    log.v.toLowerCase().includes(s) || 
                    log.t.toLowerCase().includes(s)
                );
            },

            get filteredVersionData() {
                if (!this.versionSearch) return this.currentVersionData;
                const s = this.versionSearch.toLowerCase();
                return this.currentVersionData.filter(item => 
                    item.category.toLowerCase().includes(s) || 
                    item.description.toLowerCase().includes(s) ||
                    item.type.toLowerCase().includes(s)
                );
            }
        }));
    });
</script>