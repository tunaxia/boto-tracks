---
import Layout from '../layouts/Layout.astro';
import LeftRail from '../components/LeftRail.astro';
import MainView from '../components/MainView.astro';
import ServiceNav from '../components/ServiceNav.astro';
---

<Layout title="Boto Tracker">
    <div class="flex h-screen w-full overflow-hidden bg-main text-[var(--text-secondary)] transition-all" 
         x-data="botoCore" 
         @keydown.window.escape="showMobileServices = false; showMobileVersions = false; activeService = null">
        
        <!-- Mobile Sidebar Overlays -->
        <div x-show="showMobileVersions" 
             x-transition:enter="transition-opacity ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-[#050505]/60 backdrop-blur-sm z-[90] lg:hidden" 
             @click="showMobileVersions = false"></div>

        <div x-show="showMobileServices" 
             x-transition:enter="transition-opacity ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-[#050505]/60 backdrop-blur-sm z-[90] md:hidden" 
             @click="showMobileServices = false"></div>

        <!-- Global Error State -->
        <div x-show="error" x-cloak x-transition.opacity class="fixed inset-0 z-[150] flex items-center justify-center p-6 bg-[#050505]/90 backdrop-blur-xl">
            <div class="bg-white dark:bg-white/5 border border-red-500/20 text-slate-900 dark:text-white p-10 rounded-[32px] max-w-lg w-full text-center shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-red-500/5 to-transparent pointer-events-none"></div>
                <div class="w-20 h-20 bg-red-500/10 rounded-[24px] flex items-center justify-center mx-auto mb-8 border border-red-500/20">
                    <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h2 class="text-3xl font-black italic uppercase tracking-tighter mb-3">System Override</h2>
                <p class="text-slate-500 dark:text-slate-400 mb-10 leading-relaxed text-sm mono" x-text="error"></p>
                <button @click="location.reload()" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl transition-all active:scale-95 shadow-lg shadow-orange-500/20 uppercase tracking-widest text-xs">Reboot Core</button>
            </div>
        </div>

        <!-- Initial Boot Loader -->
        <div x-show="loading" x-cloak x-transition.opacity class="fixed inset-0 z-[140] flex flex-col items-center justify-center bg-white dark:bg-[#050505] transition-colors duration-700">
            <div class="relative w-20 h-20 mb-8">
                <div class="absolute inset-0 border-4 border-orange-500/10 rounded-[24px]"></div>
                <div class="absolute inset-0 border-4 border-t-orange-500 rounded-[24px] animate-spin"></div>
                <img src="/favicon.png" class="absolute inset-0 m-auto w-8 h-8 opacity-50 animate-pulse" alt="Loading" />
            </div>
            <p class="mono text-slate-400 dark:text-slate-600 text-[10px] uppercase tracking-[0.4em] font-black animate-pulse">Synchronising Intel</p>
        </div>

        <!-- Layout Shell -->
        <div class="flex h-full w-full">
            <LeftRail />
            <MainView />
            <ServiceNav />
        </div>

        <!-- Service History Sidebar -->
        <div x-show="activeService" class="fixed inset-0 z-[120] flex justify-end overflow-hidden" x-cloak>
            <!-- Background Overlay -->
            <div x-show="activeService" 
                 x-transition:enter="ease-out duration-500" 
                 x-transition:enter-start="opacity-0" 
                 x-transition:enter-end="opacity-100" 
                 x-transition:leave="ease-in duration-500" 
                 x-transition:leave-start="opacity-100" 
                 x-transition:leave-end="opacity-0" 
                 class="absolute inset-0 bg-[#050505]/60 backdrop-blur-sm transition-opacity" 
                 @click="activeService = null"></div>

            <!-- Drawer Container -->
            <div x-show="activeService" 
                 x-transition:enter="transform transition ease-out duration-500" 
                 x-transition:enter-start="translate-x-full" 
                 x-transition:enter-end="translate-x-0" 
                 x-transition:leave="transform transition ease-in duration-500" 
                 x-transition:leave-start="translate-x-0" 
                 x-transition:leave-end="translate-x-full" 
                 class="relative w-screen max-w-lg bg-card border-l border-slate-200 dark:border-white/5 shadow-2xl flex flex-col h-full theme-transition">
                
                <!-- Drawer Header -->
                <div class="px-6 py-6 border-b border-subtle bg-sidebar backdrop-blur-md">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <span class="w-1 h-1 rounded-full bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.6)]"></span>
                            <span class="text-[10px] mono text-slate-500 dark:text-slate-400 font-black uppercase tracking-[0.2em]">Service History</span>
                        </div>
                        <button @click="activeService = null" aria-label="Close" class="p-1.5 bg-slate-100 dark:bg-white/10 rounded-lg text-slate-400 hover:text-orange-500 transition-all active:scale-90">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <h2 class="text-xl font-black text-slate-900 dark:text-white italic uppercase tracking-tighter leading-none mb-6" x-text="activeService"></h2>
                    
                    <div class="relative group/search">
                        <input type="text" id="serviceHistorySearch" x-model.debounce.200ms="serviceHistorySearch" placeholder="Filter history..." 
                               class="w-full bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs focus:outline-none focus:ring-4 focus:ring-orange-500/5 focus:border-orange-500/30 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 shadow-sm font-medium">
                        <svg class="absolute left-3.5 top-2.5 w-4 h-4 text-slate-400 dark:text-slate-600 group-focus-within/search:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                </div>

                <!-- History List -->
                <div class="flex-1 overflow-y-auto p-6 md:p-8 custom-scroll bg-inherit">
                    <div class="relative">
                        <div class="absolute left-[19px] top-0 bottom-0 w-[1px] bg-slate-200 dark:bg-white/10"></div>
                        
                        <div class="space-y-6">
                            <template x-for="log in filteredServiceHistory" :key="log.v + log.t">
                                <div class="relative pl-12 group/history">
                                    <div class="absolute left-[14px] top-2 w-2.5 h-2.5 rounded-full bg-white dark:bg-black border-2 border-slate-300 dark:border-white/20 shadow-sm z-10 transition-colors group-hover/history:border-orange-500"></div>
                                    
                                    <div class="flex flex-col gap-2.5 p-5 bg-slate-50/50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/5 rounded-[20px] hover:bg-white dark:hover:bg-white/[0.06] hover:border-orange-500/20 transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md">
                                        <div class="flex items-center">
                                            <button @click="selectVersion(log.v); activeService = null" 
                                                    class="px-2.5 py-1 bg-white dark:bg-white/10 border border-slate-200 dark:border-white/10 rounded-md mono text-[9px] font-black text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white hover:border-orange-500 transition-all active:scale-95 shadow-sm" 
                                                    x-text="log.v"></button>
                                        </div>
                                        <p class="text-slate-600 dark:text-slate-300 text-[13px] md:text-[14px] leading-[1.6] font-medium tracking-tight group-hover/history:text-slate-900 dark:group-hover/history:text-white transition-colors break-words" x-text="log.t"></p>
                                    </div>
                                </div>
                            </template>

                            <!-- Empty Results State -->
                            <template x-if="filteredServiceHistory.length === 0">
                                <div class="py-32 text-center">
                                    <div class="w-16 h-16 bg-slate-100 dark:bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-6 opacity-40">
                                        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                    </div>
                                    <p class="text-xs mono uppercase tracking-[0.2em] text-slate-500 font-black">No Records Match</p>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('botoCore', () => ({
            selectedVersion: '',
            versions: [],
            allServices: [],
            currentVersionData: [],
            serviceSearch: '',
            versionSearch: '',
            versionRailSearch: '',
            activeFilter: 'all',
            railLimit: 50,
            activeService: null,
            serviceHistory: [],
            serviceHistorySearch: '',
            showMobileServices: false,
            showMobileVersions: false,
            error: null,
            loading: true,
            versionCache: {},

            isMobile(breakpoint = 768) {
                return window.matchMedia(`(max-width: ${breakpoint-1}px)`).matches;
            },

            async init() {
                try {
                    const res = await fetch('/data/track.json');
                    if (!res.ok) throw new Error('Primary track data missing');
                    const data = await res.json();
                    this.versions = data.versions;
                    this.allServices = data.allServices;

                    if (this.versions.length > 0) {
                        await this.selectVersion(this.versions[0].id);
                    }
                } catch (e) {
                    this.error = e.message;
                } finally {
                    this.loading = false;
                }
            },

            async selectVersion(id) {
                if (this.selectedVersion === id && this.currentVersionData.length > 0) return;
                
                const prevVersion = this.selectedVersion;
                this.selectedVersion = id;
                document.title = `Release ${id} | Boto Tracks`;
                
                // If in cache, swap immediately
                if (this.versionCache[id]) {
                    this.currentVersionData = this.versionCache[id];
                    this.syncIndicator(id);
                    return;
                }

                // Seamless background fetch (no loading = true)
                try {
                    const res = await fetch(`/data/versions/${id}.json`);
                    if (!res.ok) throw new Error(`Release dossier ${id} missing`);
                    const data = await res.json();
                    this.versionCache[id] = data;
                    this.currentVersionData = data;
                    this.syncIndicator(id);
                } catch (e) { 
                    this.error = `Connection lost: ${id}`;
                    this.selectedVersion = prevVersion;
                }
            },

            syncIndicator(id) {
                const main = document.querySelector('main.flex-1');
                if (main) main.scrollTo({ top: 0, behavior: 'instant' });

                requestAnimationFrame(() => {
                    this.$nextTick(() => {
                        const rail = document.querySelector('.group\\/rail');
                        const active = rail?.querySelector(`button[data-version="${id}"]`);
                        if (rail && active) {
                            rail.style.setProperty('--glow-top', active.offsetTop + 'px');
                        }
                    });
                });
            },

            async openService(svc) {
                this.activeService = svc;
                this.serviceHistory = [];
                this.serviceHistorySearch = '';
                const serviceId = svc.toLowerCase().trim().replace(/[\._\s]+/g, '-').replace(/-+/g, '-');
                
                try {
                    const res = await fetch(`/data/services/${serviceId}.json`);
                    if (!res.ok) throw new Error('Service data unavailable');
                    this.serviceHistory = await res.json();
                } catch (e) { 
                    this.serviceHistory = []; 
                }
            },

            get filteredServices() {
                if (!this.serviceSearch) return this.allServices;
                const s = this.serviceSearch.toLowerCase();
                return this.allServices.filter(svc => svc.toLowerCase().includes(s));
            },

            get filteredRailVersions() {
                const s = this.versionRailSearch.toLowerCase();
                const base = s ? this.versions.filter(v => v.id.includes(s)) : this.versions;
                return base.slice(0, this.railLimit);
            },

            get hasMoreVersions() {
                const s = this.versionRailSearch.toLowerCase();
                const total = s ? this.versions.filter(v => v.id.includes(s)).length : this.versions.length;
                return this.railLimit < total;
            },

            loadMoreVersions() {
                this.railLimit += 50;
            },

            get filteredServiceHistory() {
                if (!this.serviceHistorySearch) return this.serviceHistory;
                const s = this.serviceHistorySearch.toLowerCase();
                return this.serviceHistory.filter(log => log.v.includes(s) || log.t.toLowerCase().includes(s));
            },

            get filteredVersionData() {
                let data = this.currentVersionData;
                if (this.activeFilter === 'feature') {
                    data = data.filter(i => i.type.includes('feature') || i.type.includes('api') || i.type.includes('change'));
                } else if (this.activeFilter === 'fix') {
                    data = data.filter(i => i.type.includes('fix'));
                }

                if (!this.versionSearch) return data;
                const s = this.versionSearch.toLowerCase();
                return data.filter(i => i.category.includes(s) || i.description.toLowerCase().includes(s));
            }
        }));
    });
</script>